# ===================================================
# Backend Environment Configuration (FastAPI / Render)
# ===================================================

# Port configuration (set automatically by Render / Cloud runtimes)
PORT=8001

# Allowed frontend origin (single domain e.g. Cloudflare Pages in production)
FRONTEND_URL=https://your-food-health-app.pages.dev

# Additional CORS origins (comma-separated list for local & preview)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-food-health-app.pages.dev

# (Optional) Supabase cloud persistence for scan stats and community cache
# If not provided, backend automatically falls back to local JSON persistence (.local_store.json)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key

# ===================================================
# Frontend Environment Configuration (React / Vite)
# ===================================================
# Base URL for the FastAPI backend API
# Local development: http://127.0.0.1:8001
# Production deployment: https://your-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8001
